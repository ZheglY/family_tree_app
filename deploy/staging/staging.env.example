# Copy this file outside the repository, restrict its permissions and replace every
# placeholder. The staging Compose file requires the resulting absolute path.

POSTGRES_URL=postgres://family_tree:replace-me@postgres.example.internal:6432/family_tree?sslmode=verify-full
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_CONNECT_TIMEOUT=5s

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=replace-with-private-staging-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_USE_PATH_STYLE=false
S3_ENCRYPTION=AES256

IDENTITY_GRPC_ADDR=identity.staging.example:443
IDENTITY_GRPC_TIMEOUT=3s
IDENTITY_GRPC_TLS_SERVER_NAME=identity.staging.example
IDENTITY_GRPC_CA_FILE=

HTTP_ALLOWED_ORIGINS=https://staging.example
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAME_SITE=strict

AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_BACKEND=redis
AUTH_RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-bytes
AUTH_RATE_LIMIT_REDIS_ADDR=redis.example.internal:6379
AUTH_RATE_LIMIT_REDIS_USERNAME=
AUTH_RATE_LIMIT_REDIS_PASSWORD=replace-me
AUTH_RATE_LIMIT_REDIS_DB=0

LOGGER_LEVEL=INFO

WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_RETRY_BASE_DELAY=2s
WORKER_RETRY_MAX_DELAY=15m
WORKER_ACK_TIMEOUT=5s

MEDIA_CLEANUP_INTERVAL=1h
MEDIA_CLEANUP_PENDING_TTL=24h
MEDIA_CLEANUP_DELETED_RETENTION=720h
MEDIA_CLEANUP_BATCH_SIZE=100

EXPORT_RESULT_TTL=168h
EXPORT_CLEANUP_INTERVAL=1h
EXPORT_CLEANUP_BATCH_SIZE=100
EXPORT_MAX_ARCHIVE_BYTES=268435456
EXPORT_MAX_VISUAL_NODES=250
EXPORT_MAX_VISUAL_PIXELS=32000000
