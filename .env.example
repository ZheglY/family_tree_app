HTTP_ADDR=":8080"
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
LOGGER_LEVEL=DEBUG
LOGGER_FOLDER=./logs

POSTGRES_URL=postgres://family_tree:family_tree@localhost:5434/family_tree?sslmode=disable
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_HEALTH_CHECK_PERIOD=15s
POSTGRES_CONNECT_TIMEOUT=5s

# Local-only credentials for the MinIO service from compose.yaml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=family-tree-media
S3_ACCESS_KEY_ID=family-tree
S3_SECRET_ACCESS_KEY=family-tree-secret
S3_USE_PATH_STYLE=true
S3_UPLOAD_URL_TTL=15m
S3_DOWNLOAD_URL_TTL=5m
S3_REQUEST_TIMEOUT=5s
S3_MAX_UPLOAD_BYTES=26214400
# Production Yandex Object Storage: aws:kms plus a KMS key ID; local MinIO: empty.
S3_ENCRYPTION=
S3_KMS_KEY_ID=

WORKER_ID=
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_RETRY_BASE_DELAY=2s
WORKER_RETRY_MAX_DELAY=15m
WORKER_ACK_TIMEOUT=5s

MEDIA_CLEANUP_INTERVAL=1h
MEDIA_CLEANUP_PENDING_TTL=24h
MEDIA_CLEANUP_DELETED_RETENTION=720h
MEDIA_CLEANUP_BATCH_SIZE=100

IDENTITY_GRPC_ADDR=localhost:50051
IDENTITY_GRPC_TIMEOUT=3s
IDENTITY_GRPC_TLS_ENABLED=false
IDENTITY_GRPC_TLS_SERVER_NAME=
IDENTITY_GRPC_CA_FILE=

AUTH_REFRESH_COOKIE_NAME=family_tree_refresh
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict

# The memory backend is intended for one local process. Use Redis for multiple instances.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_BACKEND=memory
AUTH_RATE_LIMIT_KEY_PREFIX=family-tree:auth
AUTH_RATE_LIMIT_KEY_SECRET=
AUTH_RATE_LIMIT_MEMORY_MAX_KEYS=10000
AUTH_RATE_LIMIT_REDIS_ADDR=localhost:6379
AUTH_RATE_LIMIT_REDIS_USERNAME=
AUTH_RATE_LIMIT_REDIS_PASSWORD=
AUTH_RATE_LIMIT_REDIS_DB=0
AUTH_RATE_LIMIT_REDIS_TIMEOUT=500ms
